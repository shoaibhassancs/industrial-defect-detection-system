# Settings of the DefectLens API (backend/app/core/settings.py). Copy to `.env` for local use; real
# environments (Render) set these as environment variables. Names are case-insensitive.
# Never put secrets in this file. There are none yet: the API has no token or password.

# development | test | production. In production MODEL_DIR is required.
APP_ENV=development

# Folder of a packaged (or calibrated) model artifact, verified at start-up. Produced by
# `make package`; see docs/evaluation.md section 8. The service stays "not ready" (503 on /ready) if it
# is missing, damaged or edited.
MODEL_DIR=artifacts/bottle_wide_resnet50_2_tv_in1k_v1.0.0_release

# Optional: refuse to serve unless the artifact has exactly this version (the freeze version).
MODEL_VERSION=1.0.0

# Optional: folder holding the evaluation files (metrics.json, curves.json, histograms.json) that
# GET /api/v1/metrics/<category> serves. They must be the files the package was made with (checked by
# SHA-256). Example: evaluation/wide_resnet50_2_tv_in1k/v1.0.0/bottle
EVALUATION_DIR=

# Origins allowed to call the API from a browser, comma separated, no wildcard, no path.
ALLOWED_ORIGINS=http://localhost:5173

# Largest accepted upload in MB (1 to 50) and image limits (PLAN.md section 6.3).
MAX_UPLOAD_MB=10
MIN_IMAGE_SIDE=64
MAX_IMAGE_SIDE=8000
MAX_IMAGE_PIXELS=40000000

# Rate limit on POST /api/v1/inspections, per client: "<count>/<second|minute|hour>".
RATE_LIMIT=10/minute

# How many reverse proxies sit in front of the API and append to X-Forwarded-For. 0 = none: the
# header is ignored. 1 = one proxy: the last entry is the real client. UNVERIFIED for Render: check
# Render's current documentation before deploying (backend/app/core/clientip.py).
TRUSTED_PROXY_HOPS=0

# CPU threads for the model (1 to 16) and how long a request may wait for its turn before it gets
# 503 BUSY. The threads setting is a rough knob, not a CPU quota: measure on the target.
TORCH_NUM_THREADS=1
INFERENCE_QUEUE_TIMEOUT_S=10

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are JSON lines on stdout.
LOG_LEVEL=INFO

# Release 2 (history, reports): not built. Must stay false.
PERSISTENCE_ENABLED=false
