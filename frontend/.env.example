# Frontend settings (Vite reads VITE_* variables at build time; they end up in the public bundle,
# so never put a secret here). Copy to .env.local to change them; .env.local is git-ignored.

# Address of the backend API. The backend must list this site's address in its ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000

# Where docs/evaluation.md can be read (the Model page links to it). Default: this project's GitHub
# repository, main branch. Point it elsewhere for a fork or a deployed docs site.
# VITE_DOCS_BASE_URL=https://github.com/<owner>/<repo>/blob/main/docs

# The project's source code (the footer links to it). Default: this project's GitHub repository.
# VITE_SOURCE_URL=https://github.com/<owner>/<repo>
