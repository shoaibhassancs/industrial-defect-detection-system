  "info": {
    "description": "Educational anomaly-detection demo on MVTec AD. Results are demo decisions, not quality certifications; scores are not probabilities.",
    "title": "DefectLens API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/categories": {
      "get": {
        "description": "Supported categories with their calibration and a short evaluation summary.",
        "operationId": "categories_api_v1_categories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryInfo"
                  },
                  "title": "Response Categories Api V1 Categories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not ready or busy (MODEL_NOT_READY, BUSY); see the Retry-After header"
          }
        },
        "summary": "Categories",
        "tags": [
          "model"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness: 200 as soon as the process is up.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/inspections": {
      "post": {
        "operationId": "create_inspection_api_v1_inspections_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_inspection_api_v1_inspections_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Upload too large (FILE_TOO_LARGE)"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not a JPEG or PNG (UNSUPPORTED_MEDIA_TYPE)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request or image (VALIDATION_ERROR, UNSUPPORTED_CATEGORY, INVALID_IMAGE, IMAGE_DIMENSIONS)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limited (RATE_LIMITED); see the Retry-After header"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Server error (INFERENCE_FAILED, INTERNAL_ERROR)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not ready or busy (MODEL_NOT_READY, BUSY); see the Retry-After header"
          }
        },
        "summary": "Create Inspection",
        "tags": [
          "inspections"
        ]
      }
    },
    "/api/v1/metrics/{category}": {
      "get": {
        "description": "Sealed-evaluation results for a category (from files checked against the package).",
        "operationId": "metrics_api_v1_metrics__category__get",
        "parameters": [
          {
            "in": "path",
            "name": "category",
            "required": true,
            "schema": {
              "title": "Category",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Metrics Api V1 Metrics  Category  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request or image (VALIDATION_ERROR, UNSUPPORTED_CATEGORY, INVALID_IMAGE, IMAGE_DIMENSIONS)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not ready or busy (MODEL_NOT_READY, BUSY); see the Retry-After header"
          }
        },
        "summary": "Metrics",
        "tags": [
          "model"
        ]
      }
    },
    "/api/v1/model": {
      "get": {
        "description": "What the model is, how it was calibrated, and what it can not do.",
        "operationId": "model_api_v1_model_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Model Api V1 Model Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not ready or busy (MODEL_NOT_READY, BUSY); see the Retry-After header"
          }
        },
        "summary": "Model",
        "tags": [
          "model"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "200 only after the model is loaded, verified and warmed up; otherwise 503.",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
